# =============================================================
# Law-RAG-Agent 环境配置
# 复制此文件为 .env 后修改
# =============================================================

# ---- LLM 后端 ----
# 后端类型: ollama (本地) | openai (API)
LLM_BACKEND=ollama
# --- Ollama 配置 ---
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://localhost:11434
# --- OpenAI 兼容配置 (DeepSeek / 通义千问 / vLLM) ---
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_MAX_TOKENS=2048
LLM_MAX_RETRIES=3

# ---- Embedding 后端 ----
# 后端类型: ollama (本地) | openai (API)
# 不设置默认使用 ollama
EMBED_BACKEND=ollama
# --- Ollama 配置 ---
EMBED_MODEL=bge-m3
EMBED_BASE_URL=http://localhost:11434
# --- OpenAI 兼容配置 ---
# OPENAI_EMBED_MODEL=text-embedding-3-small

EMBED_BATCH_SIZE=32
EMBED_MAX_RETRIES=3

# ---- 检索 ----
RETRIEVAL_TOP_K=5
# bge-m3 语义检索已足够强，默认关闭混合检索减少干扰
# 如果用 nomic-embed-text 建议开启，BM25 权重 0.7
RETRIEVAL_HYBRID_ENABLED=false
RETRIEVAL_BM25_WEIGHT=0.0
# 向量相似度召回阈值（bge-m3 归一化内积，范围约[-1,1]；0.95≈强相关、<0.4较差）
# 0.0=关闭；启用后可丢弃低相似度噪声候选
RETRIEVAL_SIM_THRESHOLD=0.4

# ---- 向量索引 ----
# 仅 PG_ENABLED=false 时（FAISS 回退）使用；pgvector 主力模式下不需要
INDEX_NAME=law_index_bge
INDEX_DIR=data/vector_store

# ---- LangGraph 多 Agent ----
# 开启后自动查询改写 + 答案校验防幻觉
AGENT_ENABLED=true
AGENT_MAX_RETRIES=1

# ---- pgvector (主力检索后端) ----
# 默认开启：法律条文量大（数千+），pgvector 的 HNSW + halfvec 优于 FAISS
# 本地文件索引；设为 false 才回退到 FAISS
PG_ENABLED=true
PG_CONN=postgresql://lawrag:lawrag123@localhost:5432/lawrag

# ---- 重排序 (Reranker) ----
# 需要 sentence-transformers + torch，首次加载较慢（~2GB 模型）
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_RECALL_K=15
RERANK_TOP_K=15

# ---- 相邻法条扩展 ----
# 检索时自动补全前后 N 条法条，保持法律条文连续性
ADJACENT_ENABLED=true
ADJACENT_WINDOW=3

# ---- 服务 ----
HOST=0.0.0.0
PORT=8000
